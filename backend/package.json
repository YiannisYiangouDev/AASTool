{
  "name": "aas-backend",
  "version": "1.0.0",
  "private": true,
  "description": "AAS — Accessibility Assessment Scheme — Kernel Backend",
  "type": "commonjs",
  "main": "dist/index.js",
  "scripts": {
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "build": "tsc && mkdir -p dist/data && cp src/data/*.json dist/data/",
    "test": "npx ts-node src/tests/calculation.test.ts",
    "test:automated": "npx ts-node src/tests/metadata.test.ts && npx ts-node src/tests/static.test.ts && npx ts-node src/tests/calculation.test.ts",
    "verify:workbook": "npx ts-node src/scripts/extract_workbook_mappings.ts",
    "migrate": "npx ts-node src/scripts/runMigrations.ts",
    "seed": "npx ts-node src/scripts/seed.ts",
    "docker:build": "docker build -t aas-backend:latest .",
    "docker:run": "docker run -p 4000:4000 --env-file .env aas-backend:latest"
  },
  "dependencies": {
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.4",
    "helmet": "^7.0.0",
    "mysql": "^2.18.1",
    "reflect-metadata": "^0.1.13",
    "typeorm": "^0.3.17"
  },
  "devDependencies": {
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.17",
    "@types/node": "^20.6.2",
    "ts-node": "^10.9.1",
    "typescript": "^5.1.6"
  }
}
