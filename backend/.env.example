# Example environment for local MariaDB
# Copy to .env and edit secrets as needed. Do NOT commit .env with real credentials.

DATABASE_URL="mysql://myuser:mypassword@127.0.0.1:3306/mydb"
DB_TYPE=mariadb
# For production, keep synchronize=false and use migrations
TYPEORM_SYNCHRONIZE=false

# Auth — required for login to work
JWT_SECRET="change-me-to-a-random-string"
JWT_EXPIRES_IN=3600

# Optional
PORT=4000
APP_VERSION=1.0.0
LOGIN_REDIRECT=/dashboard
