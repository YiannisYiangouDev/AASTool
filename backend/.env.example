# ═══════════════════════════════════════════════════════════════
# AASTool Backend — Environment Configuration
# ═══════════════════════════════════════════════════════════════
# Copy this file to .env and edit secrets as needed.
# NEVER commit the .env file to version control.
# ═══════════════════════════════════════════════════════════════

# ── Database ─────────────────────────────────────────────────────
# Full MySQL/MariaDB connection string (takes precedence over individual vars)
DATABASE_URL="mysql://myuser:mypassword@127.0.0.1:3306/mydb"

# Individual database connection parameters (used when DATABASE_URL is not set)
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_NAME=mydb
DATABASE_USER=myuser
DATABASE_PASSWORD=mypassword
DATABASE_SSL=false

# ORM driver: mariadb or postgres
DB_TYPE=mariadb

# WARNING: Always keep false in production. Use migrations instead.
TYPEORM_SYNCHRONIZE=false

# ── Server ───────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development
APP_VERSION=1.0.0
TRUST_PROXY=false

# Request size limit (e.g., 1mb, 500kb)
REQUEST_LIMIT=1mb

# ── CORS ─────────────────────────────────────────────────────────
# Comma-separated list of allowed origins.
# Example: https://app.example.com,https://staging.example.com
# Leave empty to allow all origins (development only).
CORS_ORIGIN=""

# ── Auth ─────────────────────────────────────────────────────────
# Required for login to work — generate a random 64-character string
JWT_SECRET="change-me-to-a-random-string"
JWT_EXPIRES_IN=3600
LOGIN_REDIRECT=/dashboard

# ── Logging ──────────────────────────────────────────────────────
# Levels: debug, info, warn, error, silent
LOG_LEVEL=info

# ── Rate Limiting ────────────────────────────────────────────────
# Only active in production (NODE_ENV=production)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ── Reports ──────────────────────────────────────────────────────
REPORT_LOCALE=en-GB
REPORT_TITLE_PREFIX="Accessibility Report"
ASSESSMENT_STATUS=Completed

# ── Frontend ─────────────────────────────────────────────────────
# URL of the deployed frontend (used for CORS, redirects, etc.)
FRONTEND_URL=

# ── Azure (optional) ────────────────────────────────────────────
AZURE_STORAGE_CONNECTION_STRING=
